# Runtime
NODE_ENV=development
PORT=3000
SITE_URL=https://style-abakan.ru

# SQLite
DATABASE_URL="file:./dev.db"

# Admin
ADMIN_LOGIN=change-me
# Создать: npm run admin:hash -- "НАДЕЖНЫЙ_ПАРОЛЬ"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_generated_by_npm_run_admin_hash
SESSION_SECRET=replace_with_at_least_64_random_characters

# SMTP / Mail.ru
# ВАЖНО: SMTP_PASS — это НЕ обычный пароль от почты.
# Для Mail.ru нужен отдельный пароль внешнего приложения:
# Настройки -> Все настройки -> Безопасность -> Пароли для внешних приложений.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@mail.ru
SMTP_PASS=replace_with_mailru_application_password
TO_EMAIL=recipient@example.com
